# Required: customer / self-hosted Gateway with ARA enabled (NOT api.akeyless.io)
AKEYLESS_GATEWAY_URL=https://gw.example.com:8000

# Auth — production on AgentCore: aws_iam; local: access_key | oidc | saml
AKEYLESS_ACCESS_TYPE=access_key
AKEYLESS_ACCESS_ID=p-xxxxx
AKEYLESS_ACCESS_KEY=
# OIDC/SAML: set ACCESS_TYPE=oidc (or saml) + ACCESS_ID; browser login opens automatically

# Optional
# AKEYLESS_AGENT_ID=bedrock-agentcore
# AKEYLESS_MCP_ID=akeyless-agentcore-rta
# AKEYLESS_DEFAULT_SECRET_NAME=/path/to/secret
